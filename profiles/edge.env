# No GPU: a tiny local model (runs on a laptop CPU) + cloud Tier-2 for anything it can't verify.
# Needs GROQ_API_KEY in .env.
PROFILE_TITLE=Edge · laptop + cloud
PROFILE_DESCRIPTION=qwen2.5 0.5B local (CPU-friendly) → gpt-oss-120b on Groq. Minimal hardware; verifier decides what goes out.
PROFILE_RECORDING=data/recorded_runs_t2-gpt-oss-120b_t1-qwen2.5-0.5b.jsonl
TIER1_BASE_URL=http://localhost:11434/v1
TIER1_MODEL=qwen2.5:0.5b
TIER1_PARAMS_B=0.5
TIER2_BASE_URL=https://api.groq.com/openai/v1
TIER2_MODEL=openai/gpt-oss-120b
TIER2_API_KEY_ENV=GROQ_API_KEY
TIER2_PARAMS_B=5.1
TIER2_EXTRA_BODY={"reasoning_effort":"low","max_tokens":1024}
