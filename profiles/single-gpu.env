# Both tiers local on one GPU: no data leaves the machine.
# Measured on an AMD RX 7900 XTX (24 GB) with both models resident:
#   OLLAMA_MAX_LOADED_MODELS=2 OLLAMA_NUM_PARALLEL=1 OLLAMA_KEEP_ALIVE=-1 ollama serve
# Any GPU that holds ~12 GB of weights works; smaller GPUs can drop Tier-2 to a 7B model.
PROFILE_TITLE=Single GPU · on-premise
PROFILE_DESCRIPTION=qwen2.5 3B → qwen2.5 14B, both local. Maximum compute savings; no data leaves the machine.
PROFILE_RECORDING=data/recorded_runs.jsonl
TIER1_BASE_URL=http://localhost:11434/v1
TIER1_MODEL=qwen2.5:3b
TIER1_PARAMS_B=3
TIER2_BASE_URL=http://localhost:11434/v1
TIER2_MODEL=qwen2.5:14b
TIER2_PARAMS_B=14
