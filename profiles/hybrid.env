# Strong local Tier-1 + cloud Tier-2: most requests stay on-premise, hard ones go to the cloud.
# Needs GROQ_API_KEY in .env (the key is never stored in this file).
PROFILE_TITLE=Hybrid · local + cloud
PROFILE_DESCRIPTION=qwen3.5 9B local → gpt-oss-120b on Groq. Near cloud-level accuracy; ~80% of tasks never leave the machine.
PROFILE_RECORDING=data/recorded_runs_t2-gpt-oss-120b_t1-qwen3.5-9b.jsonl
TIER1_BASE_URL=http://localhost:11434/v1
TIER1_MODEL=qwen3.5:9b
TIER1_PARAMS_B=9
# a fast Tier-1 answers directly; thinking would spend the token budget before answering
TIER1_EXTRA_BODY={"reasoning_effort":"none"}
TIER2_BASE_URL=https://api.groq.com/openai/v1
TIER2_MODEL=openai/gpt-oss-120b
TIER2_API_KEY_ENV=GROQ_API_KEY
# mixture-of-experts: ~5.1B active parameters per token
TIER2_PARAMS_B=5.1
TIER2_EXTRA_BODY={"reasoning_effort":"low","max_tokens":1024}
# Optional: fill from your provider's current price list to get cost in USD in the reports
# TIER2_PRICE_IN_PER_MTOK=
# TIER2_PRICE_OUT_PER_MTOK=
