# Profile A — 100% local, both models co-resident in 24GB VRAM
#   OLLAMA_MAX_LOADED_MODELS=2 OLLAMA_NUM_PARALLEL=1 OLLAMA_KEEP_ALIVE=-1 ollama serve
TIER1_BASE_URL=http://localhost:11434/v1
TIER1_MODEL=qwen2.5:3b
TIER1_API_KEY=ollama
TIER1_PARAMS_B=3
TIER2_BASE_URL=http://localhost:11434/v1
TIER2_MODEL=qwen2.5:14b
TIER2_API_KEY=ollama
TIER2_PARAMS_B=14

# Profile B — local Tier-1 + Groq Tier-2
# TIER2_BASE_URL=https://api.groq.com/openai/v1
