# Copy to .env (git-ignored). Pick a deployment profile from profiles/ and add any cloud API keys.
#
#   single-gpu  qwen2.5 3B → qwen2.5 14B, both local (no data leaves the machine)
#   hybrid      qwen3.5 9B local → gpt-oss-120b cloud (cloud-level accuracy, most tasks stay local)
#   edge        qwen2.5 0.5B local, CPU-friendly → gpt-oss-120b cloud (minimal hardware)
#   cloud       ALLaM-2 7B → gpt-oss-120b, both cloud (no local hardware)
#
# The UI can switch profiles at runtime; the CLI uses this variable (default: built-in single-gpu models).
OPTIROUTE_PROFILE=single-gpu

# Keys are read by name from profiles (e.g. TIER2_API_KEY_ENV=GROQ_API_KEY); never put keys in profiles.
GROQ_API_KEY=

# Any setting can also be given directly to build your own setup (a profile, if set, takes precedence):
# TIER1_BASE_URL=http://localhost:11434/v1     # any OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, cloud)
# TIER1_MODEL=qwen2.5:3b
# TIER1_PARAMS_B=3                             # active parameters (B), used for compute units
# TIER1_EXTRA_BODY={"reasoning_effort":"none"} # provider-specific request options
# TIER1_PRICE_IN_PER_MTOK=                     # optional USD per 1M tokens, from your provider's price list
# TIER1_PRICE_OUT_PER_MTOK=
# TIER2_... (same keys)
# LATENCY_SLO_MS=8000
