# No local hardware at all: a small cloud model as Tier-1, a large cloud model as Tier-2.
# Tier-1 is ALLaM-2-7B (SDAIA's Arabic-English model). Needs GROQ_API_KEY in .env.
PROFILE_TITLE=Cloud-only · ALLaM + gpt-oss
PROFILE_DESCRIPTION=ALLaM-2 7B → gpt-oss-120b, both on Groq. No local hardware; the cascade cuts large-model traffic.
PROFILE_RECORDING=data/recorded_runs_t2-gpt-oss-120b_t1-allam-2-7b.jsonl
TIER1_BASE_URL=https://api.groq.com/openai/v1
TIER1_MODEL=allam-2-7b
TIER1_API_KEY_ENV=GROQ_API_KEY
TIER1_PARAMS_B=7
TIER2_BASE_URL=https://api.groq.com/openai/v1
TIER2_MODEL=openai/gpt-oss-120b
TIER2_API_KEY_ENV=GROQ_API_KEY
TIER2_PARAMS_B=5.1
TIER2_EXTRA_BODY={"reasoning_effort":"low","max_tokens":1024}
